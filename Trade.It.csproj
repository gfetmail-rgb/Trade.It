<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="SymbolDefinitionForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="SymbolDefinitionForm.Designer.cs">
      <DependentUpon>SymbolDefinitionForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="SymbolDefinitionForm.resx">
      <DependentUpon>SymbolDefinitionForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>